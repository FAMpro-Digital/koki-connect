# Site public relié au Supabase LOCAL — copier en « .env.supabase-local » (ignoré par Git).
# Utilisé uniquement par « node scripts/serve-local.mjs ». Toute autre adresse que 127.0.0.1:54321 est refusée.
KOKI_LOCAL_SUPABASE_URL=http://127.0.0.1:54321
# Clé « Publishable » affichée par « supabase status » (identique sur toutes les installations locales).
KOKI_LOCAL_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
KOKI_LOCAL_PORT=8080
KOKI_LOCAL_ADMIN_URL=http://127.0.0.1:5173/
# Commandes métier (commerces, services, transport) activées seulement pour ce serveur local.
KOKI_LOCAL_BUSINESS=true
