{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "fix/lisibilite-textes-client": false,
      "develop/phases-2-6": false,
      "develop/bibliotheque-education": false,
      "develop/bibliotheque-supabase": false,
      "develop/sante": false,
      "develop/commerce": false,
      "develop/activation-commerce": false,
      "fix/inscription-formulaire": false,
      "fix/inscription-diagnostic": false,
      "develop/activation-transport": false,
      "fix/libelles-chauffeur": false,
      "develop/parcours-pro": false,
      "securite/refus-chauffeur-motif": false,
      "develop/profil-espace": false,
      "develop/transport-interface": false,
      "develop/transport-suivi": false,
      "develop/rubriques-signalements": false,
      "develop/navigation-fluide": false,
      "develop/transport-lieux": false,
      "develop/icone-app": false,
      "develop/admin-client-alignement": false,
      "develop/pages-plein-ecran": false,
      "develop/education-moderne": false,
      "develop/sports-asc": false,
      "develop/barre-activite": false,
      "develop/glisser-onglets": false,
      "develop/corrections-bugs": false,
      "develop/opportunites": false,
      "develop/evenements": false,
      "develop/services-publics": false,
      "develop/profil-simple": false,
      "develop/rubriques-uniques": false,
      "develop/audit-corrections": false,
      "fix/profil-pro-styles": false
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://qsbmzzbiztfqysstepxm.supabase.co https://tile.openstreetmap.org; connect-src 'self' https://qsbmzzbiztfqysstepxm.supabase.co wss://qsbmzzbiztfqysstepxm.supabase.co https://api.open-meteo.com; media-src 'self' blob: https://qsbmzzbiztfqysstepxm.supabase.co; font-src 'self' data:; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), camera=(self), microphone=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        }
      ]
    }
  ]
}
