  "rewrites": [
    {
      "source": "/p/:id",
      "destination": "/api/partage?id=:id"
    },
    {
      "source": "/f/:id",
      "destination": "/api/partage?fiche=:id"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: https://qsbmzzbiztfqysstepxm.supabase.co https://tile.openstreetmap.org; connect-src 'self' https://qsbmzzbiztfqysstepxm.supabase.co wss://qsbmzzbiztfqysstepxm.supabase.co https://api.open-meteo.com; media-src 'self' blob: https://qsbmzzbiztfqysstepxm.supabase.co; frame-src https://www.youtube-nocookie.com; font-src 'self' data:; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), camera=(self), microphone=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
