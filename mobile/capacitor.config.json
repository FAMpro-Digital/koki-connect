{
  "appId": "com.kokiconnect.app",
  "appName": "KOKI CONNECT",
  "webDir": "www",
  "ios": {
    "contentInset": "automatic",
    "backgroundColor": "#ffffff",
    "preferredContentMode": "mobile"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#ffffff",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "overlaysWebView": false
    }
  }
}
